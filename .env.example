# Copie este archivo como .env y ajuste los valores. Nunca suba su .env real al repositorio.

# --- Servidor ---
PORT=3000
# HOST=0.0.0.0            # dentro de Docker/Render (el Dockerfile ya lo define)
# NODE_ENV=production

# --- PostgreSQL: use DATABASE_URL o las variables POSTGRES_* por separado ---
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
# Con `npm run db:up` la base del contenedor queda en localhost:5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=auditsys
POSTGRES_PASSWORD=auditsys
POSTGRES_DB=auditsys
# PGSSL=true              # solo si se conecta a una base externa que exige SSL

# --- Seguridad ---
# AUDITSYS_SECRET=una-cadena-larga-y-aleatoria   # firma de sesiones (si falta, se genera y guarda en la BD)
# COOKIE_SECURE=false                            # true en producción con HTTPS
# TRUST_PROXY=1                                  # detrás del proxy de Render
# ADMIN_PASSWORD=...                             # contraseña inicial del admin (solo al crear la BD)
# AUDITOR_PASSWORD=...                           # contraseña inicial de los auditores de prueba

# --- Datos de ejemplo ---
# AUDITSYS_NO_DEMO=1      # no cargar la auditoría de Empresa ABC en una BD nueva
