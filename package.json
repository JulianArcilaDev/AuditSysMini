{
  "name": "auditsys-mini",
  "version": "1.1.0",
  "description": "AuditSys Mini – Sistema de Gestión de Auditorías de Sistemas de Información (ISO/IEC 27001/27002:2022)",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "seed:demo": "node --env-file-if-exists=.env server/seed.js --demo",
    "test": "node --test tests/*.test.js",
    "db:up": "docker compose up -d db",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "keywords": [
    "auditoria",
    "iso27001",
    "iso27002",
    "seguridad"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1"
  }
}
